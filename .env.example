SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=file
CACHE_PREFIX=

FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Redis Cloud (TLS): rediss://default:YOUR_PASSWORD@YOUR_HOST:PORT/0
REDIS_URL=

QUEUE_CRITICAL=critical
QUEUE_HIGH=high
QUEUE_DEFAULT=default
QUEUE_LOW=low

# Laravel Scout / Algolia (use Write API key as ALGOLIA_SECRET — never commit real keys)
SCOUT_DRIVER=collection
SCOUT_QUEUE=true
SCOUT_CANDIDATE_INDEX=candidates
ALGOLIA_APP_ID=
ALGOLIA_SECRET=

# Looking to send emails in production? Check out our Email API/SMTP product!
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=472b931508a9cd
MAIL_PASSWORD=f6b126a63222bd
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_EXPIRATION=1440

# API Configuration
API_PREFIX=api
API_VERSION=v1
API_RATE_LIMIT=60
API_RATE_LIMIT_PER_MINUTE=60
API_THROTTLE_ATTEMPTS=5
API_THROTTLE_DECAY_MINUTES=1
API_AUTH_RATE_LIMIT_PER_MINUTE=5
API_AUTH_TOKEN_EXPIRY_DAYS=30
API_AUTH_LOCKOUT_MAX_ATTEMPTS=5
API_AUTH_LOCKOUT_DECAY_MINUTES=15

# Cache TTLs (seconds) — app-plan §15
CACHE_TTL_USER_PERMISSIONS=600
CACHE_TTL_MASTER_DATA=86400
CACHE_TTL_FEATURED_PROFILES=300
CACHE_TTL_DASHBOARD_METRICS=900
CACHE_TTL_PROFILE_OPTIONS=3600

# KYC private URLs (S3 signed links when enabled)
KYC_USE_SIGNED_URLS=false
KYC_SIGNED_URL_MINUTES=15

# Localization
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en
SUPPORTED_LOCALES=en,es,fr,de

# Activity Log
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_DELETE_RECORDS_OLDER_THAN_DAYS=365

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT="${APP_ENV}"

# Feature Flags
FEATURE_API_V2=false
FEATURE_WEBSOCKETS=false

# Swagger/OpenAPI
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

GOOGLE_CHAT_WEBHOOK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
PAYTRACE_PASSWORD=

FS_DISK=s3
S3_URL=
