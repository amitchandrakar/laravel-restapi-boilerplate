APP_NAME="Laravel API Boilerplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Public URL for S3 bucket (used for category/product image URLs, e.g. https://your-bucket.s3.region.amazonaws.com)
AWS_URL=
# Optional path prefix for images (e.g. admin-images). Used by config/custom.php for entity image URLs.
S3_FOLDER=admin-images
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_EXPIRATION=1440

# CORS (Cross-Origin Resource Sharing)
# Use * to allow all origins, or comma-separated URLs (e.g. https://app.example.com,https://admin.example.com)
CORS_ALLOWED_ORIGINS=*
# Set to true when using Sanctum cookie/SPA auth (then set CORS_ALLOWED_ORIGINS to your frontend URL)
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=0

# Candidate profile images (upload pipeline: ORIGINAL / MD / SM / square ICON for notifications)
# Icon is center-cropped square; size is width and height in pixels (clamped 1–512 in code).
# Stored image_url / thumbnail_url / icon_url are absolute http(s) URLs; image_storage_path holds the MD disk key.
# Ensure APP_URL matches your public API base so relative disk URLs resolve correctly.
USER_PROFILE_IMAGE_ICON_SIZE=50
USER_PROFILE_IMAGE_FOLDER_ICON=ICON
USER_PROFILE_IMAGE_QUALITY_ICON=75

# API Configuration
API_PREFIX=api
API_VERSION=v1
API_RATE_LIMIT=60
API_THROTTLE_ATTEMPTS=5
API_THROTTLE_DECAY_MINUTES=1

# Localization
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en
SUPPORTED_LOCALES=en,es,fr,de

# Activity Log
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_DELETE_RECORDS_OLDER_THAN_DAYS=365

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT="${APP_ENV}"

# Feature Flags
FEATURE_API_V2=false
FEATURE_WEBSOCKETS=false

# Swagger/OpenAPI
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false
