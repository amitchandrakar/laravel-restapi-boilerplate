APP_NAME="Laravel API Boilerplate"
APP_ENV=local
APP_KEY=base64:ziuv2xzuIeE9i/p1RdU4WaG3/+4TgPVsQf2VOKuyUsQ=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://community-connect-api.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_API_CALLS=false
LOG_USER_ACTIVITY_ON_READ=false
TELESCOPE_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community_connect
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=api_

FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

MEMCACHED_HOST=127.0.0.1

# Use local Redis in development (start with: brew services start redis).
# If Redis is not installed/running, use CACHE_STORE=database and SESSION_DRIVER=database instead.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=0

# Looking to send emails?
# - APP_ENV=local: these MAIL_* values are used for notification email (welcome, password reset).
# - APP_ENV=staging|production: notification email uses Admin → Notification settings (DB).
#   emailEnabled must be on; leftover MAIL_* below is not used for those sends.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=472b931508a9cd
MAIL_PASSWORD=f6b126a63222bd
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging (HTTP v1) — Android + iOS
# Download service account JSON from Firebase Console → Project settings → Service accounts.
# Prefer an absolute path; default looks under storage/app/firebase/service-account.json
FIREBASE_CREDENTIALS=
# Optional override if project_id is not inside the JSON:
FIREBASE_PROJECT_ID=
# Inline JSON alternative (avoid in committed .env): FIREBASE_CREDENTIALS_JSON=
FIREBASE_PUSH_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_EXPIRATION=1440

# API Configuration
API_PREFIX=api
API_VERSION=v1
API_RATE_LIMIT=60
API_THROTTLE_ATTEMPTS=5
API_THROTTLE_DECAY_MINUTES=1

# Localization
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en
SUPPORTED_LOCALES=en,es,fr,de

# Activity Log
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_DELETE_RECORDS_OLDER_THAN_DAYS=365

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=https://c37263ee451f37e31bae6a83d26ab685@o4509419027562496.ingest.us.sentry.io/4511423648628736
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT="${APP_ENV}"

# Feature Flags
FEATURE_API_V2=false
FEATURE_WEBSOCKETS=false

# Swagger/OpenAPI
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

GOOGLE_CHAT_WEBHOOK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
PAYTRACE_PASSWORD=

FS_DISK=s3
S3_URL=
AWS_KEY=
AWS_SECRET=
AWS_REGION=
AWS_BUCKET=
S3_FOLDER=

# Registration payments (launch: disabled — all plans complimentary until date below)
REGISTRATION_PAYMENTS_ENABLED=true

SENTRY_SEND_DEFAULT_PII=true
