APP_NAME="Laravel API Boilerplate"
APP_ENV=local
APP_KEY=base64:ziuv2xzuIeE9i/p1RdU4WaG3/+4TgPVsQf2VOKuyUsQ=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://be23-115-99-108-147.ngrok-free.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community_connect
DB_USERNAME=root
