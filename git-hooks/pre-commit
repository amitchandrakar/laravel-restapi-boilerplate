#!/bin/sh

# Fix the path to ensure we can find composer
export PATH=$PATH:/usr/local/bin:/usr/local/sbin:/opt/homebrew/bin

echo "Running pre-commit checks..."

# 1. Auto-format with Prettier (project-local prettier + @prettier/plugin-php)
echo "Running Prettier (Auto-format)..."
if [ ! -f node_modules/.bin/prettier ]; then
    echo "Installing npm dependencies (prettier, @prettier/plugin-php)..."
    npm install
    STATUS=$?
    if [ $STATUS -ne 0 ]; then
        echo "[ERROR] npm install failed!"
        exit 1
    fi
fi
npm run format
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "[ERROR] Prettier formatting failed!"
    exit 1
fi

# 2. Auto-format with Pint
echo "Running Pint (Auto-format)..."
composer format
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "[ERROR] Pint formatting failed!"
    exit 1
fi

# 3. Verify with Pint lint check
echo "Verifying code style with Pint..."
composer lint
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "[ERROR] Pint verification failed!"
    echo "💡 This shouldn't happen after auto-format. Please review the errors."
    exit 1
fi

# 4. Check code standards (PHPCS)
echo "Running PHPCS..."
composer phpcs
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "[ERROR] PHPCS check failed!"
    echo "💡 Run: composer phpcs:fix (auto-fix) or fix violations manually."
    exit 1
fi

# 5. Check Static Analysis (Larastan)
echo "Running Larastan (Static Analysis)..."
composer analyse
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "[ERROR] Larastan check failed!"
    echo "💡 Please fix the errors reported above."
    exit 1
fi

# 6. Check Tests (exclude @group manual - run those separately)
echo "Running Tests..."
php artisan test --exclude-group=manual
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "[ERROR] Tests failed!"
    exit 1
fi

echo "[OK] All checks passed! Committing..."
exit 0
